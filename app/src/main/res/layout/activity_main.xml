<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#0B1020">

    <!-- APP TITLE -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUIZFLIX"
        android:textColor="#38BDF8"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- QUESTION AND RESULT TEXT -->
    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Welcome to QuizFlix!"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:layout_marginBottom="12dp"/>

    <!-- PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/quizProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="650dp"
        android:layout_height="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#38BDF8"
        android:layout_marginBottom="12dp"/>

    <!-- QUESTION TIMER -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time Left: 20s"
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <!-- ANSWER BUTTONS -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2">

        <Button
            android:id="@+id/btnOption1"
            android:layout_width="320dp"
            android:layout_height="70dp"
            android:layout_margin="8dp"
            android:background="@drawable/tv_answer_background"
            android:focusable="true"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            tools:ignore="SpeakableTextPresentCheck" />

        <Button
            android:id="@+id/btnOption2"
            android:layout_width="320dp"
            android:layout_height="70dp"
            android:layout_margin="8dp"
            android:background="@drawable/tv_answer_background"
            android:focusable="true"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            tools:ignore="SpeakableTextPresentCheck" />

        <Button
            android:id="@+id/btnOption3"
            android:layout_width="320dp"
            android:layout_height="70dp"
            android:layout_margin="8dp"
            android:background="@drawable/tv_answer_background"
            android:focusable="true"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            tools:ignore="SpeakableTextPresentCheck" />

        <Button
            android:id="@+id/btnOption4"
            android:layout_width="320dp"
            android:layout_height="70dp"
            android:layout_margin="8dp"
            android:background="@drawable/tv_answer_background"
            android:focusable="true"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            tools:ignore="SpeakableTextPresentCheck" />

    </GridLayout>

    <!-- BACK TO HOME BUTTON -->
    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/tv_answer_background"
        android:text="Back to Home"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:focusable="true"
        android:visibility="gone"/>

    <!-- SCORE AND FEEDBACK -->
    <TextView
        android:id="@+id/tvScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Score: 0"
        android:textColor="#FACC15"
        android:textSize="20sp"
        android:layout_marginTop="12dp"/>

    <!-- TV REMOTE INSTRUCTIONS -->
    <TextView
        android:id="@+id/tvInstructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Use arrows to navigate • Press Select to answer"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginTop="10dp"/>

</LinearLayout>
